msgid "Image files must be 5 MB or smaller."
msgstr "Les images doivent peser 5 Mo ou moins."

msgid "Upload a valid image file."
msgstr "Veuillez envoyer un fichier image valide."

msgid "Video files must be 10 MB or smaller."
msgstr "Les videos doivent peser 10 Mo ou moins."

msgid "Upload a valid MP4, WebM, or MOV video file."
msgstr "Veuillez envoyer une video valide au format MP4, WebM ou MOV."

msgid "External video media requires a URL."
msgstr "Une video externe doit avoir une URL."

msgid "Uploaded media requires a file."
msgstr "Un media envoye doit contenir un fichier."

msgid "End date must be after start date."
msgstr "La date de fin doit etre posterieure a la date de debut."

msgid "Authentication is required."
msgstr "L'authentification est obligatoire."

msgid "Tenants can create maintenance requests only for their rented properties."
msgstr "Les locataires peuvent creer des demandes de maintenance uniquement pour les biens qu'ils louent."

msgid "A listing needs a title."
msgstr "Une annonce doit avoir un titre."

msgid "City and district cannot be empty."
msgstr "La ville et le quartier sont obligatoires."

msgid "Rooms, surface and price cannot be negative."
msgstr "Les pieces, la surface et le prix ne peuvent pas etre negatifs."

msgid "Unknown listing status."
msgstr "Statut d'annonce inconnu."

msgid "Unknown category."
msgstr "Categorie inconnue."

msgid "Only landlords and agency members can add listings."
msgstr "Seuls les bailleurs et les membres d'une agence peuvent ajouter des annonces."

msgid "You can only edit your own listings."
msgstr "Vous ne pouvez modifier que vos propres annonces."

msgid "Only the landlord can answer this request."
msgstr "Seul le bailleur peut repondre a cette demande."

#, python-format
msgid "You already have a pending request for this listing. You can send a new one once the landlord answers it, or from %(date)s."
msgstr "Vous avez deja une demande en cours pour ce bien. Vous pourrez en envoyer une nouvelle apres la reponse du bailleur, ou a partir du %(date)s."
