# Django
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
LANGUAGE_CODE=fr

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database
# Local SQLite is used when DATABASE_URL is omitted.
# Neon example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60
DATABASE_CONN_HEALTH_CHECKS=True

# Media storage (images/videos)
# Local disk (media/) is used when CLOUDINARY_URL is omitted.
# Free pilot option: create a Cloudinary account (25GB/month free) and copy the
# "API Environment variable" from the dashboard, e.g.:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_MEDIA_PREFIX=immoizi
CLOUDINARY_MEDIA_TAG=immoizi

# HTTPS security for production
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
